{
  "name": "@model-ts/eventbridge",
  "version": "7.1.0",
  "description": "Publish @model-ts/core models as EventBridge events, built on Effect.",
  "keywords": [
    "effect",
    "eventbridge",
    "events",
    "model"
  ],
  "license": "MIT",
  "author": "Fabian Finke <finkef@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finkef/model-ts.git",
    "directory": "packages/eventbridge"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --project eventbridge --root ../.."
  },
  "devDependencies": {
    "@model-ts/core": "*",
    "effect": "4.0.5"
  },
  "peerDependencies": {
    "@aws-sdk/client-eventbridge": "^3.0.0",
    "@model-ts/core": "^7.0.0",
    "effect": "^4.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}

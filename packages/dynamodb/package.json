{
  "name": "@model-ts/dynamodb",
  "version": "7.0.0",
  "description": "Single-table DynamoDB for @model-ts/core models, built on Effect: typed errors, batching, transactions, tracing and an in-memory sandbox.",
  "license": "MIT",
  "author": "Fabian Finke <finkef@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finkef/model-ts.git",
    "directory": "packages/dynamodb"
  },
  "keywords": [
    "effect",
    "dynamodb",
    "single-table",
    "model"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --project dynamodb:memory --root ../..",
    "test:local": "vitest run --project dynamodb:local --root ../.."
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/util-dynamodb": "^3.0.0",
    "@model-ts/core": "^7.0.0",
    "effect": "^4.0.5"
  },
  "devDependencies": {
    "@model-ts/core": "*",
    "effect": "4.0.5"
  }
}

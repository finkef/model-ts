{
  "name": "@model-ts/dynamodb",
  "version": "7.2.0",
  "description": "Single-table DynamoDB for @model-ts/core models, built on Effect: typed errors, batching, transactions, tracing and an in-memory sandbox.",
  "keywords": [
    "dynamodb",
    "effect",
    "model",
    "single-table"
  ],
  "license": "MIT",
  "author": "Fabian Finke <finkef@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finkef/model-ts.git",
    "directory": "packages/dynamodb"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --project dynamodb:memory --root ../..",
    "test:local": "vitest run --project dynamodb:local --root ../.."
  },
  "devDependencies": {
    "@model-ts/core": "*",
    "effect": "4.0.5",
    "graphql": "16.11.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-dynamodb-streams": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/util-dynamodb": "^3.0.0",
    "@model-ts/core": "^7.0.0",
    "effect": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb-streams": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}

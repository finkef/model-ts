{
  "name": "model-ts",
  "repository": "git@github.com:finkef/model-ts.git",
  "author": "Fabian Finke <finkef@icloud.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean && node -e \"for (const name of ['core', 'dynamodb', 'eventbridge']) require('node:fs').rmSync('packages/' + name + '/dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --project core --project eventbridge --project dynamodb:memory",
    "test:local": "vitest run --project dynamodb:local",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dynamodb:start": "docker run -d --name dynamodb --rm -p 8000:8000 amazon/dynamodb-local",
    "dynamodb:stop": "docker stop dynamodb",
    "release": "bun run clean && bun run build && changeset publish"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1079.0",
    "@aws-sdk/client-eventbridge": "^3.1079.0",
    "@aws-sdk/lib-dynamodb": "^3.1079.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@changesets/cli": "^2.29.0",
    "@effect/vitest": "4.0.5",
    "@types/node": "^22.0.0",
    "effect": "4.0.5",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
